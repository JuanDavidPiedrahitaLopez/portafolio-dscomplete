# Copia este archivo como .env.local y completa tus credenciales de EmailJS
# (https://dashboard.emailjs.com) para que el formulario de /contacto
# pueda enviar correos.
#
# 1. Service ID: Email Services -> tu servicio
# 2. Template ID: Email Templates -> tu plantilla
# 3. Public Key: Account -> General -> Public Key
#
# La plantilla debe usar estas variables (o ajusta los nombres en
# src/components/contact/contact.jsx):
#   {{from_name}}  {{from_email}}  {{subject}}  {{message}}

NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=
